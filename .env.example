# ═══════════════════════════════════════════════════════════════════════════
# CoachMint — environment template (copy to .env locally; set the same keys in
# the Vercel dashboard → Settings → Environment Variables)
# ═══════════════════════════════════════════════════════════════════════════

# ── ۱) بک‌اند داده ──────────────────────────────────────────────────────────
#   SQLite پیشفرض است (data/sqlite.db) — هیچ تنظیمی لازم نیست.
#   مسیر دلخواه:
# SQLITE_PATH=./data/sqlite.db
#   اختیاری — PostgreSQL بهجای SQLite (چند-سروری/سرورلس):
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ── ۲) ادمین اصلی (الزامی) ────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com

# ── ۳) کلید سرور-به-سرور فروشگاه (الزامی برای checkout) ───────────────────
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# ── ۴) آدرس عمومی اپ (الزامی) ─────────────────────────────────────────────
# لوکال: http://localhost:8888 — Vercel: https://<project>.vercel.app
COACH_OS_URL=

# ── ۵) محیط اجرا ──────────────────────────────────────────────────────────
# NODE_ENV=production

# ── ۶) دستیار هوشمند (اختیاری — OpenRouter) ───────────────────────────────
# AI_API_KEY=sk-or-v1-...
# AI_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# ── ۷) ایمیل‌ها (اختیاری — Resend) ────────────────────────────────────────
# با این کلید سه ایمیل برند CoachMint فعال می‌شود:
#   · خوش‌آمدگویی بعد از ثبت‌نام (Welcome to CoachMint)
#   · تأیید خرید + کد فعال‌سازی بعد از پرداخت در سایت فروش
#   · بازیابی رمز عبور
# بدون کلید: هیچ ایمیلی ارسال نمی‌شود (لینک ریست فقط در لاگ سرور چاپ می‌شود).
# RESEND_API_KEY=re_...
# فرستنده ایمیل‌ها — برای دامنه اختصاصی، اول دامنه را در resend.com/domains
# تأیید کنید. مقدار پیش‌فرض فقط برای تست است (فقط به ایمیل خود اکانت Resend
# می‌رسد). مثال: CoachMint <noreply@coachmint.app>
# MAIL_FROM=CoachMint <onboarding@resend.dev>
