# Coach OS — environment template (copy to .env locally; set the same keys in Netlify dashboard)
# Backend selection (first match wins):
#   1. SUPABASE_URL + SUPABASE_SERVICE_KEY  -> Supabase Postgres (multi-instance safe)
#   2. KV_FILE                              -> JSON file on disk (single server / VPS / Docker)
#   3. neither                              -> Netlify Blobs (needs Netlify credentials)
SUPABASE_URL=https://xyzcompany.supabase.co
# SERVICE ROLE key (Project Settings > API > service_role). NEVER the anon key, never in the browser.
SUPABASE_SERVICE_KEY=eyJhbGciOi...
# Standalone server (server.mjs): file-backed KV — no external service needed.
# KV_FILE=./data/kv.json
# Standalone server: listen port (default 8888) and bind address (default 0.0.0.0).
# PORT=8888
# HOST=0.0.0.0
# Password reset delivery:
#   RESEND_API_KEY=re_...        -> send real emails via Resend (https://resend.com)
#   RESET_DELIVERY=return        -> return the link in the API response (SELF-HOST/DEV ONLY)
#   (neither)                    -> log the link to the server console
# RESEND_API_KEY=re_...
# RESET_DELIVERY=return
# RESET_FROM="Coach OS <noreply@yourdomain.com>"
# Max workspace payload in bytes (default 5000000 = 5 MB).
# DATA_MAX_BYTES=5000000
# Phase-2 billing: comma-separated emails allowed to call /api/billing/admin-overview.
# Leave empty (or unset) to keep the admin endpoint closed.
ADMIN_EMAILS=admin@coachos.app
# Main admin bootstrap (run once, NOT through the public signup form):
#   SUPABASE_URL / SUPABASE_SERVICE_KEY +  npm run admin:create -- admin@coachos.app 'S3cure!Pass' "Your Name"
# The email above should match ADMIN_EMAILS so the role flag stays in sync.
